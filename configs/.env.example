# Application
APP_ENV=development
APP_PORT=8080
APP_NAME=metapus
PUBLIC_CHECKOUT_BASE_URL=http://localhost:8080

# Database
META_DATABASE_URL=postgres://metapus:metapus@localhost:5432/tenants?sslmode=disable
DATABASE_URL=postgres://metapus:metapus@localhost:5432/mt_default?sslmode=disable
TENANT_DB_USER=metapus
TENANT_DB_PASSWORD=metapus
TENANT_DB_HOST=localhost
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Multi-Tenancy
# Note: Metapus is strictly Database-per-Tenant.
# No shared database mode is supported.

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# In-process auth/profile caches: positive TTL and entry limits per server.
AUTH_STATE_CACHE_TTL=5m
AUTH_STATE_CACHE_MAX_ENTRIES=10000
SECURITY_PROFILE_CACHE_TTL=5m
SECURITY_PROFILE_CACHE_MAX_ENTRIES=10000

# Admin MFA / Step-Up
# Generate with: openssl rand -base64 32
AUTH_MFA_ENCRYPTION_KEY=dGVzdC1tZmEtZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=
ADMIN_MFA_MODE=off
ADMIN_MFA_GRACE_PERIOD_HOURS=168
ADMIN_STEP_UP_TTL_SECONDS=300
ADMIN_SECURITY_MODE=off
ADMIN_ALLOWED_CIDRS=
# Self-registration via POST /auth/register (off: users are created by an admin)
AUTH_ALLOW_SELF_REGISTRATION=false
# Tenant whose admins may list all tenants and their pool stats (empty: none)
CONTROL_PLANE_TENANT_ID=
TRUSTED_PROXIES=

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
FEATURE_NEW_POSTING=false
FEATURE_ASYNC_POSTING=false

# Audit
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=90

# Worker
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=500ms
AUTOMATION_ENCRYPTION_KEY=test-encryption-key-32chars!!!!!

# Crypto money movement signing. Production uses transit and a tokenless Vault
# Proxy connection. Local mode is explicit and forbidden when APP_ENV=production.
# CRYPTO_APPROVAL_POLICY_BUNDLES_JWS is the multi-tenant alternative to CRYPTO_APPROVAL_POLICY_BUNDLE_JWS.
VAULT_ADDR=http://127.0.0.1:8100
CRYPTO_AUTH_SIGNER=local
CRYPTO_TRANSIT_MOUNT=transit
CRYPTO_LOCAL_AUTH_KID=transit/metapus-signing-auth-00000000-0000-0000-0000-000000000001/v1
CRYPTO_SIGNING_AUTH_PRIVATE_KEY=
CRYPTO_APPROVAL_POLICY_PUBLIC_KEY=
CRYPTO_APPROVAL_POLICY_BUNDLE_JWS=
# CRYPTO_APPROVAL_POLICY_BUNDLES_JWS=
CRYPTO_INTENT_SIGNING_PUBLIC_KEY=
CRYPTO_INTENT_SIGNING_PRIVATE_KEY=
CRYPTO_RISK_ASSESSMENT_SIGNING_PUBLIC_KEY=
CRYPTO_RISK_ASSESSMENT_SIGNING_PRIVATE_KEY=
CRYPTO_POLICY_DECISION_SIGNING_PUBLIC_KEY=
CRYPTO_POLICY_DECISION_SIGNING_PRIVATE_KEY=
CRYPTO_ADMIN_APPROVAL_SIGNING_PUBLIC_KEY=
CRYPTO_ADMIN_APPROVAL_SIGNING_PRIVATE_KEY=
CRYPTO_RISK_APPROVAL_SIGNING_PUBLIC_KEY=
CRYPTO_RISK_APPROVAL_SIGNING_PRIVATE_KEY=

# CoinGecko Demo key for the exchange-rate worker (never exposed to clients).
COINGECKO_DEMO_API_KEY=CG-ZMRA5d6zb9uh3vfT7mzc8Nqi

# Internal HTML-to-PDF capability; leave unset to disable PDF (HTML/DOCX still work).
# Compose supplies http://pdf-renderer:8081 on the private PDF network.
PDF_RENDERER_URL=
