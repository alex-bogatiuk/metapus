# Metapus local/test Single-Tenant Deployment Configuration.
# All .env* values used by this local/test checkout are test fixtures, not
# production credentials. Disclosure of these values is not a security incident.
# Copy this file to .env for local development only. Production credentials
# come from the platform secret manager and are never copied from this file.

# --- Required ---
# Generate a strong random secret for JWT tokens:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-strong-random-secret

# Required for TOTP MFA enrollment and sensitive-action step-up.
# Generate with: openssl rand -base64 32
AUTH_MFA_ENCRYPTION_KEY=dGVzdC1tZmEtZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=

# Tenant ID — filled after running:
#   docker compose run --rm init create --slug default --name "My Company"
TENANT_ID=

# Public base URL for checkout/payment links.
PUBLIC_CHECKOUT_BASE_URL=http://localhost:8080

# --- Runtime settings ---
POSTGRES_PASSWORD=metapus
LOG_LEVEL=info
AUTH_STATE_CACHE_TTL=5m
AUTH_STATE_CACHE_MAX_ENTRIES=10000
SECURITY_PROFILE_CACHE_TTL=5m
SECURITY_PROFILE_CACHE_MAX_ENTRIES=10000
ADMIN_MFA_MODE=required
ADMIN_MFA_GRACE_PERIOD_HOURS=168
ADMIN_STEP_UP_TTL_SECONDS=300
ADMIN_SECURITY_MODE=warn
ADMIN_ALLOWED_CIDRS=
TRUSTED_PROXIES=

# Required by cmd/server for encrypted automation credentials.
AUTOMATION_ENCRYPTION_KEY=test-encryption-key-32chars!!!!!

# Crypto money movement signing. Worker talks only to its dedicated Vault Proxy;
# VAULT_TOKEN and CRYPTO_SIGNING_AUTH_PRIVATE_KEY must not be present here.
# CRYPTO_APPROVAL_POLICY_BUNDLES_JWS is the multi-tenant alternative to CRYPTO_APPROVAL_POLICY_BUNDLE_JWS.
CRYPTO_PROCESSING_ENABLED=false
CRYPTO_CHAIN_CONFIG_FILE_HOST=../deployments/crypto/chains.example.json
VAULT_ADDR=http://vault-proxy:8100
CRYPTO_AUTH_SIGNER=transit
CRYPTO_TRANSIT_MOUNT=transit
CRYPTO_APPROVAL_POLICY_PUBLIC_KEY=
CRYPTO_APPROVAL_POLICY_BUNDLE_JWS=
# CRYPTO_APPROVAL_POLICY_BUNDLES_JWS=
CRYPTO_INTENT_SIGNING_PUBLIC_KEY=
CRYPTO_RISK_ASSESSMENT_SIGNING_PUBLIC_KEY=
CRYPTO_POLICY_DECISION_SIGNING_PUBLIC_KEY=
CRYPTO_ADMIN_APPROVAL_SIGNING_PUBLIC_KEY=
CRYPTO_RISK_APPROVAL_SIGNING_PUBLIC_KEY=

# Test Vault/Proxy host paths. The wrapped-secret-id file is single-use and is
# deleted by Vault Proxy after a successful login.
VAULT_TEST_PORT=8200
VAULT_CA_CERT_FILE=./vault-test/tls/ca.crt
VAULT_ROLE_ID_FILE=./vault-test/bootstrap/role-id
VAULT_BOOTSTRAP_DIR=./vault-test/bootstrap
# For an external Vault, point this at a private copy of proxy-external.example.hcl.
# VAULT_PROXY_CONFIG_FILE=/etc/metapus/vault-proxy.hcl

# Version reported by the server (set to match your source/release tag)
METAPUS_VERSION=v1.0.0

# Port mapping (host:container)
# APP_PORT=8080
# FRONTEND_PORT=3000
# POSTGRES_PORT=5432

# CoinGecko Demo key for the exchange-rate worker (never exposed to clients).
COINGECKO_DEMO_API_KEY=
