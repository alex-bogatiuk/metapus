server {
    listen 80 proxy_protocol default_server;
    server_name _;
    server_tokens off;
    set_real_ip_from 172.30.250.1/32;
    real_ip_header proxy_protocol;

    access_log off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 503;
    }
}
