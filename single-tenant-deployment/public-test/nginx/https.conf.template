map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

log_format metapus '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                   '$status $body_bytes_sent request_id=$request_id';

server {
    listen 80 proxy_protocol default_server;
    server_name _;
    server_tokens off;
    set_real_ip_from 172.30.250.1/32;
    real_ip_header proxy_protocol;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
        access_log off;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl proxy_protocol default_server;
    http2 on;
    server_name __PUBLIC_IP__;
    server_tokens off;
    set_real_ip_from 172.30.250.1/32;
    real_ip_header proxy_protocol;

    ssl_certificate     /etc/letsencrypt/live/__PUBLIC_IP__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_IP__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    access_log /var/log/nginx/access.log metapus;
    error_log /var/log/nginx/error.log warn;

    client_max_body_size 2m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 60s;
    proxy_read_timeout 60s;

    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    location = /health/live {
        include /opt/metapus/proxy-common.conf;
        proxy_pass http://metapus-app:8080;
    }

    location ^~ /api/ {
        include /opt/metapus/proxy-common.conf;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_pass http://metapus-app:8080;
    }

    location = /portal/v1 {
        include /opt/metapus/proxy-common.conf;
        proxy_pass http://metapus-app:8080;
    }

    location ^~ /portal/v1/ {
        include /opt/metapus/proxy-common.conf;
        proxy_pass http://metapus-app:8080;
    }

    location ^~ /merchant/ {
        include /opt/metapus/proxy-common.conf;
        proxy_pass http://metapus-app:8080;
    }

    location ^~ /pay/ {
        include /opt/metapus/proxy-common.conf;
        proxy_pass http://metapus-app:8080;
    }

    location / {
        include /opt/metapus/proxy-common.conf;
        proxy_pass http://frontend:3000;
    }
}
