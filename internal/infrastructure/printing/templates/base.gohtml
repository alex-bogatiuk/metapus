{{/* base.gohtml — shared styles and sub-templates included by every print form */}}

{{define "styles"}}
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Arial', 'Helvetica Neue', sans-serif;
    font-size: 11pt;
    color: #000;
    background: #fff;
    line-height: 1.4;
  }

  .page {
    max-width: 210mm;
    margin: 0 auto;
    padding: 12mm 12mm 14mm;
  }

  /* ── Document header ── */
  .doc-title {
    font-size: 15pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 5mm;
  }
  .doc-subtitle {
    font-size: 10pt;
    text-align: center;
    color: #444;
    margin-bottom: 7mm;
  }

  /* ── Header fields ── */
  .header-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 6mm;
    font-size: 10pt;
  }
  .header-table td {
    padding: 2px 6px;
    vertical-align: top;
  }
  .header-table td.label {
    white-space: nowrap;
    color: #555;
    width: 38mm;
    font-weight: normal;
  }
  .header-table td.value {
    border-bottom: 1px solid #999;
    min-width: 60mm;
  }
  .header-table td.value strong { font-weight: bold; }

  /* ── Line items table ── */
  .lines-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 5mm;
    font-size: 10pt;
  }
  .lines-table th {
    background: #f0f0f0;
    border: 1px solid #ccc;
    padding: 3px 6px;
    text-align: center;
    font-weight: bold;
    font-size: 9.5pt;
  }
  .lines-table td {
    border: 1px solid #ccc;
    padding: 3px 6px;
    vertical-align: top;
  }
  .lines-table td.num { text-align: center; width: 8mm; }
  .lines-table td.qty  { text-align: right; white-space: nowrap; }
  .lines-table td.money { text-align: right; white-space: nowrap; }
  .lines-table td.center { text-align: center; }
  .lines-table tr:nth-child(even) { background: #fafafa; }

  /* ── Totals ── */
  .totals-section {
    text-align: right;
    margin-bottom: 8mm;
    font-size: 10.5pt;
  }
  .totals-section table {
    display: inline-table;
    border-collapse: collapse;
  }
  .totals-section td {
    padding: 2px 8px;
  }
  .totals-section td.total-label { text-align: right; color: #444; }
  .totals-section td.total-value { text-align: right; font-weight: bold; min-width: 35mm; border-bottom: 1px solid #999; }
  .total-grand { font-size: 12pt; }

  /* ── Signatures ── */
  .signatures {
    display: flex;
    justify-content: space-between;
    margin-top: 12mm;
    gap: 10mm;
    font-size: 10pt;
  }
  .sig-block {
    flex: 1;
  }
  .sig-block .sig-role {
    margin-bottom: 8mm;
    color: #444;
  }
  .sig-line {
    border-bottom: 1px solid #666;
    margin-bottom: 2mm;
    height: 6mm;
  }
  .sig-hint {
    font-size: 8pt;
    color: #888;
    text-align: center;
  }

  /* ── Footer ── */
  .doc-footer {
    margin-top: 10mm;
    font-size: 8.5pt;
    color: #888;
    text-align: center;
    border-top: 1px solid #ddd;
    padding-top: 3mm;
  }

  /* ── @media print ── */
  @media print {
    body { font-size: 10pt; }
    .page { padding: 8mm 8mm 10mm; max-width: 100%; }
    @page { size: A4 portrait; margin: 15mm 12mm; }
    .lines-table { page-break-inside: auto; }
    .lines-table tr { page-break-inside: avoid; page-break-after: auto; }
    .signatures { page-break-inside: avoid; }
  }
</style>
{{end}}

{{/* table_form renders PrintData.Table; DOCX renders the same structure. */}}
{{define "table_form"}}
{{with .Table}}
  <div class="doc-title">{{.Title}}</div>
  {{if .Subtitle}}<div class="doc-subtitle">{{.Subtitle}}</div>{{end}}
  {{if .HeaderRows}}
  <table class="header-table">
    {{range .HeaderRows}}
    <tr>
      {{range .}}
      <td class="label">{{.Label}}</td>
      <td class="value">{{.Value}}</td>
      {{end}}
    </tr>
    {{end}}
  </table>
  {{end}}
  {{if .Columns}}
  <table class="lines-table">
    <thead><tr>{{range .Columns}}<th>{{.}}</th>{{end}}</tr></thead>
    <tbody>
      {{range .Rows}}
      <tr>{{range $i, $v := .Values}}<td{{if $i}} class="money"{{end}}>{{$v}}</td>{{end}}</tr>
      {{end}}
    </tbody>
  </table>
  {{end}}
  {{if .Totals}}
  <div class="totals-section">
    <table>
      {{range .Totals}}
      <tr{{if .Grand}} class="total-grand"{{end}}>
        <td class="total-label">{{.Label}}</td>
        <td class="total-value">{{.Value}}</td>
      </tr>
      {{end}}
    </table>
  </div>
  {{end}}
  {{with .SignatureBlock}}
  <div class="signatures">
    {{range .Entries}}
    <div class="sig-block">
      <div class="sig-role">{{.Role}}</div>
      <div class="sig-line"></div>
      <div class="sig-hint">{{.Hint}}</div>
    </div>
    {{end}}
  </div>
  {{end}}
  <div class="doc-footer">Сформировано автоматически системой Metapus</div>
{{end}}
{{end}}
